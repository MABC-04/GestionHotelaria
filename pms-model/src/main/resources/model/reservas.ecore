        <eStructuralFeatures xsi:type="ecore:EAttribute" name="monto" eType="#//Decimal" defaultValueLiteral="0" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="referencia" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="autorizadaEn" eType="#//EDateTime" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="horaLimiteLiberacion" eType="#//EDateTime" />
