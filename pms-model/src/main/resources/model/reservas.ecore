        <eStructuralFeatures xsi:type="ecore:EAttribute" name="estado" lowerBound="1" eType="#//EstadoRetencion" defaultValueLiteral="ACTIVA" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="tipoHabitacion" lowerBound="1" eType="#//TipoHabitacion" eOpposite="#//TipoHabitacion/retenciones" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="reserva" eType="#//Reserva" eOpposite="#//Reserva/retencion" />
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="BloqueoHabitacion">
