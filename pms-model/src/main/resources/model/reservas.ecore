        <eStructuralFeatures xsi:type="ecore:EAttribute" name="referencia" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="fecha" lowerBound="1" eType="#//EDateTime" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="folio" lowerBound="1" eType="#//Folio" eOpposite="#//Folio/pagos" />
    </eClassifiers>
</ecore:EPackage>
