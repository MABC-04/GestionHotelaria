        <eStructuralFeatures xsi:type="ecore:EReference" name="aprobadoPor" lowerBound="1" eType="#//Usuario" eOpposite="#//Usuario/aprobaciones" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="reserva" lowerBound="1" eType="#//Reserva" eOpposite="#//Reserva/aprobacionDescuento" />
    </eClassifiers>

    <!-- ================================================================
         ESTANCIA / FOLIO / CARGO / PAGO (modelados en S0, implementados en S3)
         ================================================================ -->
    <eClassifiers xsi:type="ecore:EClass" name="Estancia">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" eType="#//UUID" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="llegadaReal" lowerBound="1" eType="#//EDateTime" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="salidaReal" eType="#//EDateTime" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="autorizacionSupervisor" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="false" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="autorizacionSalidaTardia" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="false" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="reserva" lowerBound="1" eType="#//Reserva" eOpposite="#//Reserva/estancia" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="habitacion" lowerBound="1" eType="#//Habitacion" eOpposite="#//Habitacion/estancias" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="propiedad" lowerBound="1" eType="#//Propiedad" eOpposite="#//Propiedad/estancias" />
