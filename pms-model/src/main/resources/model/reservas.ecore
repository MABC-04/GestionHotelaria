        <eStructuralFeatures xsi:type="ecore:EReference" name="grupo" lowerBound="1" eType="#//GrupoReserva" eOpposite="#//GrupoReserva/bloqueos" />
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="AprobacionDescuento">
