        <eStructuralFeatures xsi:type="ecore:EAttribute" name="saldo" lowerBound="1" eType="#//Decimal" defaultValueLiteral="0" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="estancia" eType="#//Estancia" eOpposite="#//Estancia/folio" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="cargos" upperBound="-1" eType="#//Cargo" containment="true" eOpposite="#//Cargo/folio" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="pagos" upperBound="-1" eType="#//Pago" containment="true" eOpposite="#//Pago/folio" />
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="Cargo">
