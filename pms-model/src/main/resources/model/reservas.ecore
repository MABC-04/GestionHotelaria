        <eStructuralFeatures xsi:type="ecore:EAttribute" name="fecha" lowerBound="1" eType="#//EDateTime" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="folio" lowerBound="1" eType="#//Folio" eOpposite="#//Folio/cargos" />
