        <eStructuralFeatures xsi:type="ecore:EAttribute" name="observacion" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="habitacion" lowerBound="1" eType="#//Habitacion" eOpposite="#//Habitacion/bloqueos" />
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="GrupoReserva">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" eType="#//UUID" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="nombre" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="cutoff" lowerBound="1" eType="#//EDate" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="creadoEn" lowerBound="1" eType="#//EDateTime" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="estado" lowerBound="1" eType="#//EstadoGrupo" defaultValueLiteral="TENTATIVO" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="propiedad" lowerBound="1" eType="#//Propiedad" eOpposite="#//Propiedad/grupos" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="bloqueos" lowerBound="1" upperBound="-1" eType="#//BloqueoGrupo" containment="true" eOpposite="#//BloqueoGrupo/grupo" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="reservas" upperBound="-1" eType="#//Reserva" eOpposite="#//Reserva/grupo" />
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="BloqueoGrupo">
